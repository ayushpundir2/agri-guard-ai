# Environment Variables Configuration

# Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_USER=agriguard
POSTGRES_PASSWORD=agriguard_secret
POSTGRES_DB=agriguard_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agriguard:agriguard_secret@localhost:5432/agriguard_db

# External APIs
GEMINI_API_KEY=your_gemini_api_key_here

# Target Prototype Region
PROTOTYPE_CITY=Pune, Maharashtra, India
PROTOTYPE_LAT=18.5204
PROTOTYPE_LNG=73.8567

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json
